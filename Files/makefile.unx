#
# Makefile for the TEST hidden curve remover.
#

include ../makeflag.unx

OBJS =	test.o$(IRIT_OBJ_PF)

all:	test$(IRIT_EXE_PF)

test$(IRIT_EXE_PF):	$(OBJS)
	$(CC) $(CFLAGS) -o test$(IRIT_EXE_PF) $(OBJS) $(MOREOBJS) \
	$(IRIT_LIBS) $(IRIT_MORE_LIBS) $(GRAPOGLLIBS) -lm

testAll: \
	testAttr$(IRIT_EXE_PF) \
	testCrvPtDist$(IRIT_EXE_PF) \
	testGauss$(IRIT_EXE_PF) \
	testImage$(IRIT_EXE_PF) \
	testFFDCB$(IRIT_EXE_PF) \
	testMS$(IRIT_EXE_PF) \
	testMS1CT$(IRIT_EXE_PF) \
	testMS2CT$(IRIT_EXE_PF) \
	testMS2$(IRIT_EXE_PF) \
	testMS3$(IRIT_EXE_PF) \
	testMS4$(IRIT_EXE_PF) \
	testMS5$(IRIT_EXE_PF) \
	testMS6$(IRIT_EXE_PF) \
	testMS7$(IRIT_EXE_PF) \
	testMSTile$(IRIT_EXE_PF) \
	testMSTile1$(IRIT_EXE_PF) \
	testMSTile2$(IRIT_EXE_PF) \
	testMSWing$(IRIT_EXE_PF) \
	testMatchCrvs$(IRIT_EXE_PF) \
	testMdlBool$(IRIT_EXE_PF) \
	testMemLeak$(IRIT_EXE_PF) \
	testMemLeak2$(IRIT_EXE_PF) \
	testMin$(IRIT_EXE_PF) \
	testPoly$(IRIT_EXE_PF) \
	testRocketFuel$(IRIT_EXE_PF) \
	testRocketFuel2$(IRIT_EXE_PF) \
	testSrfPtDist$(IRIT_EXE_PF) \
	testSrfPtDist2$(IRIT_EXE_PF) \
	testTV$(IRIT_EXE_PF) \
	testTVMdl$(IRIT_EXE_PF) \
