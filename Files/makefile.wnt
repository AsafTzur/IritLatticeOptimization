include ..\makeflag.wnt

OBJS =	test.$(IRIT_OBJ_PF) 

test$(IRIT_EXE_PF).exe: $(OBJS)
	$(IRITCONLINK) -out:$@ $(OBJS) $(IRIT_LIBS) $(IRIT_MORE_LIBS) $(W32CONMTLIBS)
	$(IRITMANIFEST) -manifest $@.manifest -outputresource:$@;1


