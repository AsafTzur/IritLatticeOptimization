+            int TileIndex = GlobalId / Opt -> L;
+            int SubTileIndex = GlobalId % Opt -> L;
+            Opt -> Lattice.Tiles[TileIndex].SubTiles[SubTileIndex].Thickness = Avg;
+        }
+    }
+}
